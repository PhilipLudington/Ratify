{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src/worker/**/*.ts",
    "src/do/**/*.ts",
    "src/shared/**/*.ts",
    "functions/**/*.ts",
    "tests/**/*.ts"
  ],
  // Two test directories are typechecked elsewhere, because each needs a lib
  // this half deliberately lacks: the client's tests need DOM
  // (tsconfig.client.json), and the script tests need Node's builtins
  // (tsconfig.scripts.json). Neither belongs in workerd's world.
  "exclude": ["tests/client/**/*.ts", "tests/scripts/**/*.ts"]
}
